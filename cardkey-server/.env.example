# 必填：直接复用 seatpool_prod 的 DSN（不写不会启动）
# DATABASE_URL=postgresql+psycopg://USER:PASS@127.0.0.1:5432/seatpool_prod

# 可选：调试时显式开启 SQL echo
SQLALCHEMY_ECHO=false

# 可选：自定义日志级别（INFO/DEBUG/WARNING）
LOG_LEVEL=INFO

# 可选：插件接口的速率限制覆盖（单 IP/卡密/邮箱 60s 内最多请求次数）
PLUGIN_RATE_LIMIT_WINDOW_SECONDS=60
PLUGIN_RATE_LIMIT_MAX_REQUESTS=20
