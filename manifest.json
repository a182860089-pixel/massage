{
  "manifest_version": 3,
  "name": "ChatGPT 对话保存助手",
  "version": "1.0.0",
  "description": "自动保存 ChatGPT 对话，支持导出为 HTML、Markdown、PDF 格式",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://seat.20050225.xyz/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/fetchInterceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/lib/turndown.min.js",
        "src/lib/html2canvas.min.js",
        "src/lib/jspdf.umd.min.js",
        "src/utils/fileSystem.js",
        "src/utils/htmlExporter.js",
        "src/utils/mdExporter.js",
        "src/utils/pdfExporter.js",
        "src/utils/jsonExporter.js",
        "src/utils/tokenEstimator.js",
        "src/utils/selectionManager.js",
        "src/utils/searchIndex.js",
        "src/utils/templateManager.js",
        "src/utils/accessManager.js",
        "src/utils/exporter.js",
        "src/content/parser.js",
        "src/content/observer.js",
        "src/content/content.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.jpg"],
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"]
    }
  ]
}
