# scripts/*.sh / remote_ssh.py 用到的本地环境变量
# 用法：
#   cp scripts/.env.example scripts/.env.local
#   编辑 scripts/.env.local 填入真实值
#   source scripts/.env.local       # bash/zsh
#   或在 PowerShell:  $env:PGPASSWORD="..."

# 远程服务器 cardkey-admin / cardkey-server 使用的 PostgreSQL 密码
export PGPASSWORD="<your_postgres_password>"

# 部署到远程时写入 .env 的 DATABASE_URL 用的密码（remote-deploy.sh / deploy-cardkey-admin.sh）
export POSTGRES_PASSWORD="<your_postgres_password>"

# 后台 admin 默认密码（DEPLOY_STATUS.md / cli 创建账号时用，所有文档里写 <ADMIN_PASSWORD> 即此值）
# 注意：上线前请通过 `flask create-admin admin <新密码>` 改掉默认值
export ADMIN_PASSWORD="<your_admin_password>"

# 服务器 SSH 凭据：保存在 scripts/.remote-credentials.json（已 .gitignore，不进仓库）
# 格式：{ "host": "x.x.x.x", "port": 22, "username": "root", "password": "..." }
